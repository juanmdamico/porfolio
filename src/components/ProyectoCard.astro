---
import { slugDe, type Proyecto } from '../proyectos';
import { textos, rutaBase, type Idioma } from '../i18n';

interface Props {
  proyecto: Proyecto;
  idioma: Idioma;
}

const { proyecto, idioma } = Astro.props;
const { titulo, resumen, tecnologias, fecha, imagen } = proyecto.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a class="card" href={`${rutaBase(idioma)}/proyectos/${slugDe(proyecto)}/`}>
  {
    imagen && (
      <div class="captura">
        <img src={`${base}/capturas/${imagen}`} alt="" width="800" height="500" loading="lazy" decoding="async" />
      </div>
    )
  }
  <div class="cuerpo">
    <span class="fecha">{fecha.getFullYear()}</span>
    <h3>{titulo}</h3>
    <p>{resumen}</p>
    <ul class="tags">
      {tecnologias.map((t) => <li>{t}</li>)}
    </ul>
    <span class="ver">{textos[idioma].verProyecto}</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 12px 32px -12px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .captura {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--accent-soft);
  }
  .captura img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.4s;
  }
  .card:hover .captura img { transform: scale(1.04); }
  .cuerpo { display: flex; flex-direction: column; gap: 12px; padding: 22px 24px 24px; flex: 1; }
  .fecha { font-size: 0.8rem; color: var(--muted); font-weight: 600; }
  h3 { margin: 0; font-size: 1.25rem; }
  p { margin: 0; color: var(--muted); flex: 1; }
  .ver { color: var(--accent); font-weight: 600; font-size: 0.9rem; }
</style>
