---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { slugDe, type Proyecto } from '../proyectos';
import { textos, rutaBase, type Idioma } from '../i18n';

interface Props {
  proyecto: Proyecto;
  idioma: Idioma;
}

const { proyecto, idioma } = Astro.props;
const t = textos[idioma];
const { titulo, resumen, tecnologias, fecha, demo, codigo, imagen } = proyecto.data;
const { Content } = await render(proyecto);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const otro: Idioma = idioma === 'es' ? 'en' : 'es';
const alternativa = `${rutaBase(otro)}/proyectos/${slugDe(proyecto)}/`;
---

<Base titulo={titulo} descripcion={resumen} idioma={idioma} alternativa={alternativa}>
  <article class="container">
    <a class="volver" href={`${rutaBase(idioma)}/#proyectos`}>{t.volver}</a>
    <p class="fecha">
      {fecha.toLocaleDateString(idioma === 'es' ? 'es-AR' : 'en-US', { month: 'long', year: 'numeric' })}
    </p>
    <h1>{titulo}</h1>
    <p class="resumen">{resumen}</p>
    <ul class="tags">
      {tecnologias.map((tec) => <li>{tec}</li>)}
    </ul>
    {
      (demo || codigo) && (
        <div class="acciones">
          {demo && (
            <a class="btn btn-primary" href={demo}>
              {t.verDemo}
            </a>
          )}
          {codigo && (
            <a class="btn" href={codigo} target="_blank" rel="noopener">
              {t.verCodigo}
            </a>
          )}
        </div>
      )
    }
    {imagen && <img class="captura" src={`${base}/capturas/${imagen}`} alt={titulo} width="1200" height="750" />}
    <div class="contenido">
      <Content />
    </div>
  </article>
</Base>

<style>
  article { max-width: 760px; padding-top: 48px; padding-bottom: 72px; }
  .volver { color: var(--muted); text-decoration: none; font-weight: 500; }
  .volver:hover { color: var(--accent); }
  .fecha { color: var(--muted); margin: 32px 0 4px; }
  .fecha::first-letter { text-transform: uppercase; }
  h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin: 0 0 12px; }
  .resumen { font-size: 1.15rem; color: var(--muted); margin: 0 0 20px; }
  .acciones { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .captura {
    display: block;
    width: 100%;
    margin-top: 32px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .contenido {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .contenido :global(h2) { margin-top: 32px; font-size: 1.4rem; }
  .contenido :global(code) {
    font-size: 0.9em;
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--accent-soft);
  }
</style>
