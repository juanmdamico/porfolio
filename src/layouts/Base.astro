---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { perfil } from '../data/perfil';
import { textos, rutaBase, type Idioma } from '../i18n';

interface Props {
  titulo?: string;
  descripcion?: string;
  idioma?: Idioma;
  /** URL de esta misma página en el otro idioma. Si no hay, se enlaza a la portada. */
  alternativa?: string;
}

const { titulo, idioma = 'es', alternativa } = Astro.props;
const t = textos[idioma];
const datos = perfil[idioma];
const descripcion = Astro.props.descripcion ?? datos.frase;
const tituloCompleto = titulo ? `${titulo} · ${perfil.nombre}` : `${perfil.nombre} · ${datos.rol}`;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const inicio = rutaBase(idioma);
const otroIdioma: Idioma = idioma === 'es' ? 'en' : 'es';
const urlAlternativa = alternativa ?? `${rutaBase(otroIdioma)}/`;
const enConversor = Astro.url.pathname.startsWith(`${base}/conversor`);
const enBlog = Astro.url.pathname.startsWith(`${base}/blog`);
const imagenOg = new URL(`${base}/og.png`, Astro.site).href;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={`Blog · ${perfil.nombre}`} href={`${base}/rss.xml`} />
    <title>{tituloCompleto}</title>
    <script is:inline>
      // Aplica el tema guardado antes de pintar, para evitar un parpadeo.
      try {
        const tema = localStorage.getItem('tema');
        if (tema === 'light' || tema === 'dark') document.documentElement.dataset.theme = tema;
      } catch {}
    </script>
    {
      perfil.goatcounter && (
        <script
          is:inline
          async
          data-goatcounter={`https://${perfil.goatcounter}.goatcounter.com/count`}
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a href={`${inicio}/`} class="logo">{perfil.nombre}</a>
        <nav id="menu" aria-label={t.menu}>
          <a href={`${inicio}/#proyectos`}>{t.proyectos}</a>
          <a href={`${inicio}/#sobre-mi`}>{t.sobreMi}</a>
          <a href={`${base}/blog/`} aria-current={enBlog ? 'page' : undefined}>{t.blog}</a>
          <a href={`${inicio}/#contacto`}>{t.contacto}</a>
          <a href={`${base}/conversor/`} class="nav-destacado" aria-current={enConversor ? 'page' : undefined}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 3l4 4-4 4" /><path d="M21 7H9a4 4 0 0 0-4 4" />
              <path d="M7 21l-4-4 4-4" /><path d="M3 17h12a4 4 0 0 0 4-4" />
            </svg>
            {t.conversor}
          </a>
        </nav>
        <div class="herramientas-nav">
          <a class="idioma" href={urlAlternativa} hreflang={otroIdioma} lang={otroIdioma} title={t.otroIdioma}>
            {otroIdioma.toUpperCase()}
          </a>
          <button class="icono" id="tema" type="button" aria-label={t.tema} title={t.tema}>
            <svg class="sol" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg class="luna" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
          </button>
          <button class="icono hamburguesa" id="abrir-menu" type="button" aria-label={t.menu} aria-expanded="false" aria-controls="menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="container">
        © {new Date().getFullYear()} {perfil.nombre}{' · '}
        <a href={perfil.links.github} target="_blank" rel="noopener">GitHub</a>{' · '}
        <a href={`${base}/rss.xml`}>RSS</a>
      </div>
    </footer>
  </body>
</html>

<script>
  const raiz = document.documentElement;

  // Tema: alterna entre claro y oscuro, partiendo del que se ve ahora.
  document.getElementById('tema')!.addEventListener('click', () => {
    const oscuroAhora =
      raiz.dataset.theme === 'dark' ||
      (!raiz.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const nuevo = oscuroAhora ? 'light' : 'dark';
    raiz.dataset.theme = nuevo;
    try {
      localStorage.setItem('tema', nuevo);
    } catch {}
    window.dispatchEvent(new CustomEvent('cambio-tema'));
  });

  // Menú en celulares.
  const boton = document.getElementById('abrir-menu')!;
  const menu = document.getElementById('menu')!;
  const cerrar = () => {
    menu.classList.remove('abierto');
    boton.setAttribute('aria-expanded', 'false');
  };
  boton.addEventListener('click', () => {
    const abierto = menu.classList.toggle('abierto');
    boton.setAttribute('aria-expanded', String(abierto));
  });
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', cerrar));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && cerrar());
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 60px;
  }
  .logo {
    font-weight: 800;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    margin-right: auto;
  }
  nav { display: flex; align-items: center; gap: 20px; }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
  }
  nav a:hover,
  nav a[aria-current='page'] { color: var(--text); }
  nav .nav-destacado {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
    transition: background 0.15s, color 0.15s;
  }
  nav .nav-destacado:hover,
  nav .nav-destacado[aria-current='page'] {
    background: var(--accent);
    color: var(--on-accent);
  }
  nav .nav-destacado svg { transition: transform 0.3s; }
  nav .nav-destacado:hover svg { transform: rotate(180deg); }

  .herramientas-nav { display: flex; align-items: center; gap: 6px; }
  .icono,
  .idioma {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    min-width: 36px;
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--muted);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }
  .icono:hover,
  .idioma:hover { color: var(--text); border-color: var(--accent); }

  /* Muestra la luna en modo claro y el sol en modo oscuro. */
  .sol { display: none; }
  :global(:root[data-theme='dark']) .sol { display: block; }
  :global(:root[data-theme='dark']) .luna { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sol { display: block; }
    :global(:root:not([data-theme='light'])) .luna { display: none; }
  }

  .hamburguesa { display: none; }

  @media (max-width: 860px) {
    .hamburguesa { display: inline-flex; }
    nav {
      display: none;
      position: absolute;
      top: 60px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 20px 20px;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      box-shadow: 0 16px 32px -16px rgb(0 0 0 / 0.25);
    }
    nav:global(.abierto) { display: flex; }
    nav a { padding: 12px 4px; font-size: 1rem; border-bottom: 1px solid var(--border); }
    nav .nav-destacado { margin-top: 12px; justify-content: center; padding: 10px; border: 0; }
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 32px 0;
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
  }
  .footer a { color: var(--muted); }
  .footer a:hover { color: var(--accent); }
</style>
