---
import '../styles/global.css';
import { perfil } from '../data/perfil';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { titulo, descripcion = perfil.frase } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${perfil.nombre}` : `${perfil.nombre} · ${perfil.rol}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const enConversor = Astro.url.pathname.startsWith(`${base}/conversor`);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{tituloCompleto}</title>
  </head>
  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a href={`${base}/`} class="logo">{perfil.nombre}</a>
        <nav>
          <a href={`${base}/#proyectos`}>Proyectos</a>
          <a href={`${base}/#sobre-mi`}>Sobre mí</a>
          <a href={`${base}/#contacto`}>Contacto</a>
          <a href={`${base}/conversor/`} class="nav-destacado" aria-current={enConversor ? 'page' : undefined}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 3l4 4-4 4" /><path d="M21 7H9a4 4 0 0 0-4 4" />
              <path d="M7 21l-4-4 4-4" /><path d="M3 17h12a4 4 0 0 0 4-4" />
            </svg>
            Conversor
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="container">© {new Date().getFullYear()} {perfil.nombre}</div>
    </footer>
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 60px;
  }
  .logo {
    font-weight: 800;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  nav { display: flex; align-items: center; gap: 20px; }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
  }
  nav a:hover { color: var(--text); }
  nav .nav-destacado {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
    transition: background 0.15s, color 0.15s;
  }
  nav .nav-destacado:hover,
  nav .nav-destacado[aria-current='page'] {
    background: var(--accent);
    color: #fff;
  }
  nav .nav-destacado svg { transition: transform 0.3s; }
  nav .nav-destacado:hover svg { transform: rotate(180deg); }
  @media (max-width: 520px) {
    .logo { display: none; }
    .nav-inner { justify-content: center; }
    nav { gap: 12px; }
    nav a { font-size: 0.88rem; }
    nav .nav-destacado { padding: 5px 10px; }
  }
  .footer {
    border-top: 1px solid var(--border);
    padding: 32px 0;
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
  }
</style>
