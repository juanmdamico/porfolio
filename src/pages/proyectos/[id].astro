---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((proyecto) => ({ params: { id: proyecto.id }, props: { proyecto } }));
}

const { proyecto } = Astro.props;
const { titulo, resumen, tecnologias, fecha, demo, codigo } = proyecto.data;
const { Content } = await render(proyecto);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base titulo={titulo} descripcion={resumen}>
  <article class="container">
    <a class="volver" href={`${base}/#proyectos`}>← Volver</a>
    <p class="fecha">
      {fecha.toLocaleDateString('es-AR', { month: 'long', year: 'numeric' })}
    </p>
    <h1>{titulo}</h1>
    <p class="resumen">{resumen}</p>
    <ul class="tags">
      {tecnologias.map((t) => <li>{t}</li>)}
    </ul>
    {(demo || codigo) && (
      <div class="acciones">
        {demo && <a class="btn btn-primary" href={demo} target="_blank" rel="noopener">Ver demo</a>}
        {codigo && <a class="btn" href={codigo} target="_blank" rel="noopener">Ver código</a>}
      </div>
    )}
    <div class="contenido">
      <Content />
    </div>
  </article>
</Base>

<style>
  article { max-width: 720px; padding-top: 48px; padding-bottom: 72px; }
  .volver { color: var(--muted); text-decoration: none; font-weight: 500; }
  .volver:hover { color: var(--accent); }
  .fecha { color: var(--muted); margin: 32px 0 4px; }
  h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin: 0 0 12px; }
  .resumen { font-size: 1.15rem; color: var(--muted); margin: 0 0 20px; }
  .acciones { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .contenido {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .contenido :global(h2) { margin-top: 32px; font-size: 1.4rem; }
  .contenido :global(blockquote) {
    margin: 32px 0;
    padding: 12px 20px;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 8px 8px 0;
  }
</style>
