---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.borrador);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const palabras = post.body?.split(/\s+/).length ?? 0;
const minutos = Math.max(1, Math.round(palabras / 200));
---

<Base titulo={post.data.titulo} descripcion={post.data.resumen}>
  <article class="container post">
    <a class="volver" href={`${base}/blog/`}>← Blog</a>
    <p class="meta">
      <time datetime={post.data.fecha.toISOString()}>
        {post.data.fecha.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' })}
      </time>
      · {minutos} min de lectura
    </p>
    <h1>{post.data.titulo}</h1>
    <p class="resumen">{post.data.resumen}</p>
    <div class="contenido">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post { max-width: 720px; padding-top: 48px; padding-bottom: 72px; }
  .volver { color: var(--muted); text-decoration: none; font-weight: 500; }
  .volver:hover { color: var(--accent); }
  .meta { color: var(--muted); margin: 32px 0 8px; font-size: 0.9rem; }
  h1 { font-size: clamp(2rem, 5vw, 2.7rem); margin: 0 0 12px; }
  .resumen { font-size: 1.15rem; color: var(--muted); margin: 0; }
  .contenido { margin-top: 36px; padding-top: 12px; border-top: 1px solid var(--border); font-size: 1.05rem; }
  .contenido :global(h2) { margin-top: 40px; font-size: 1.5rem; }
  .contenido :global(pre) {
    padding: 16px;
    border-radius: 10px;
    overflow-x: auto;
    font-size: 0.88rem;
    border: 1px solid var(--border);
  }
  .contenido :global(:not(pre) > code) { font-size: 0.9em; padding: 2px 6px; border-radius: 6px; background: var(--accent-soft); }
  .contenido :global(blockquote) { margin: 24px 0; padding: 4px 20px; border-left: 3px solid var(--accent); color: var(--muted); }
</style>
