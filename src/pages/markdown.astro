---
import Herramienta from '../layouts/Herramienta.astro';
---

<Herramienta
  titulo="Editor de Markdown"
  descripcion="Escribí en Markdown con vista previa en vivo y exportá a HTML o PDF. Se guarda solo en tu navegador."
  ancha
>
  <div class="editor tarjeta">
    <div class="barra-herramientas" role="toolbar" aria-label="Formato">
      <button type="button" data-accion="negrita" title="Negrita (Ctrl+B)"><b>B</b></button>
      <button type="button" data-accion="cursiva" title="Cursiva (Ctrl+I)"><i>I</i></button>
      <button type="button" data-accion="titulo" title="Título">H</button>
      <span class="separador"></span>
      <button type="button" data-accion="enlace" title="Enlace (Ctrl+K)">🔗</button>
      <button type="button" data-accion="lista" title="Lista">•</button>
      <button type="button" data-accion="tareas" title="Lista de tareas">☑</button>
      <button type="button" data-accion="cita" title="Cita">❝</button>
      <button type="button" data-accion="codigo" title="Código">&lt;/&gt;</button>
      <button type="button" data-accion="tabla" title="Tabla">▦</button>
      <span class="espacio"></span>
      <div class="modos" role="tablist" aria-label="Vista">
        <button type="button" role="tab" data-modo="editar" aria-selected="true">Editar</button>
        <button type="button" role="tab" data-modo="vista" aria-selected="false">Vista previa</button>
      </div>
    </div>

    <div class="paneles" id="paneles" data-modo="editar">
      <label class="sr-only" for="texto">Texto en Markdown</label>
      <textarea id="texto" spellcheck="true"></textarea>
      <article class="vista" id="vista" aria-live="off"></article>
    </div>

    <div class="pie">
      <span id="estadisticas"></span>
      <span id="guardado"></span>
    </div>
  </div>

  <div class="acciones exportar">
    <button class="btn btn-primary" type="button" id="pdf">Exportar PDF</button>
    <button class="btn" type="button" id="html">Descargar .html</button>
    <button class="btn" type="button" id="md">Descargar .md</button>
    <button class="btn" type="button" id="copiar-html">Copiar HTML</button>
    <button class="btn" type="button" id="reiniciar">Restaurar ejemplo</button>
  </div>
</Herramienta>

<script>
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';
  import { $, avisar, copiar, descargar } from '../scripts/comun';

  const EJEMPLO = `# Bienvenido al editor de Markdown

Escribí a la izquierda y mirá el resultado a la derecha. **Todo se guarda solo** en tu navegador.

## Qué podés hacer

- Texto en **negrita**, *cursiva* y ~~tachado~~
- [Enlaces](https://juanmdamico.github.io/porfolio/) y \`código en línea\`
- Listas de tareas:
  - [x] Escribir el borrador
  - [ ] Exportarlo a PDF

> Consejo: usá **Ctrl+B**, **Ctrl+I** y **Ctrl+K** para dar formato rápido.

## Código

\`\`\`js
function saludar(nombre) {
  return \`¡Hola, \${nombre}!\`;
}
\`\`\`

## Tablas

| Formato | Extensión | Uso |
| --- | --- | --- |
| Markdown | .md | Documentación |
| HTML | .html | Web |
| PDF | .pdf | Imprimir o compartir |
`;

  const texto = $<HTMLTextAreaElement>('texto');
  const vista = $('vista');
  marked.setOptions({ gfm: true, breaks: false });

  // DOMPurify evita que un Markdown con <script> u otros trucos ejecute código.
  const aHtml = (md: string) => DOMPurify.sanitize(marked.parse(md) as string);

  let temporizador: ReturnType<typeof setTimeout>;
  function actualizar() {
    vista.innerHTML = aHtml(texto.value);
    const palabras = texto.value.trim().split(/\s+/).filter(Boolean).length;
    const minutos = Math.max(1, Math.round(palabras / 200));
    $('estadisticas').textContent = `${palabras} palabras · ${texto.value.length} caracteres · ${minutos} min de lectura`;
    clearTimeout(temporizador);
    $('guardado').textContent = '';
    temporizador = setTimeout(() => {
      try {
        localStorage.setItem('markdown-borrador', texto.value);
        $('guardado').textContent = '✓ Guardado';
      } catch {}
    }, 500);
  }

  // ---------- Formato ----------
  /** Envuelve la selección (o inserta un texto de ejemplo) con marcadores. */
  function envolver(antes: string, despues = antes, ejemplo = 'texto') {
    const { selectionStart: ini, selectionEnd: fin, value } = texto;
    const seleccion = value.slice(ini, fin) || ejemplo;
    texto.setRangeText(`${antes}${seleccion}${despues}`, ini, fin, 'end');
    texto.setSelectionRange(ini + antes.length, ini + antes.length + seleccion.length);
    texto.focus();
    actualizar();
  }

  /** Agrega un prefijo al comienzo de cada línea seleccionada. */
  function prefijar(prefijo: string) {
    const { selectionStart, selectionEnd, value } = texto;
    const ini = value.lastIndexOf('\n', selectionStart - 1) + 1;
    const fin = selectionEnd;
    const lineas = value.slice(ini, fin).split('\n').map((l) => prefijo + l);
    texto.setRangeText(lineas.join('\n'), ini, fin, 'end');
    texto.focus();
    actualizar();
  }

  function insertarBloque(bloque: string) {
    const { selectionStart: ini, value } = texto;
    const antes = ini > 0 && value[ini - 1] !== '\n' ? '\n\n' : '';
    texto.setRangeText(`${antes}${bloque}\n`, ini, texto.selectionEnd, 'end');
    texto.focus();
    actualizar();
  }

  const acciones: Record<string, () => void> = {
    negrita: () => envolver('**'),
    cursiva: () => envolver('*'),
    titulo: () => prefijar('## '),
    enlace: () => envolver('[', '](https://)', 'enlace'),
    lista: () => prefijar('- '),
    tareas: () => prefijar('- [ ] '),
    cita: () => prefijar('> '),
    codigo: () =>
      texto.value.slice(texto.selectionStart, texto.selectionEnd).includes('\n')
        ? envolver('```\n', '\n```', 'código')
        : envolver('`', '`', 'código'),
    tabla: () => insertarBloque('| Columna 1 | Columna 2 |\n| --- | --- |\n| Dato | Dato |'),
  };

  document.querySelectorAll<HTMLButtonElement>('[data-accion]').forEach((b) =>
    b.addEventListener('click', () => acciones[b.dataset.accion!]()),
  );

  texto.addEventListener('keydown', (e) => {
    if (e.key === 'Tab') {
      e.preventDefault();
      texto.setRangeText('  ', texto.selectionStart, texto.selectionEnd, 'end');
      return actualizar();
    }
    if (!(e.ctrlKey || e.metaKey)) return;
    const atajo = { b: 'negrita', i: 'cursiva', k: 'enlace' }[e.key.toLowerCase()];
    if (atajo) {
      e.preventDefault();
      acciones[atajo]();
    }
  });
  texto.addEventListener('input', actualizar);

  // ---------- Modo editar / vista previa (en pantallas chicas) ----------
  document.querySelectorAll<HTMLButtonElement>('[data-modo]').forEach((b) =>
    b.addEventListener('click', () => {
      $('paneles').dataset.modo = b.dataset.modo;
      document.querySelectorAll('[data-modo]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
    }),
  );

  // ---------- Exportar ----------
  const titulo = () => texto.value.match(/^#\s+(.+)$/m)?.[1].trim() ?? 'documento';
  const nombreArchivo = () =>
    titulo()
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '') || 'documento';

  function documentoHtml() {
    const escapar = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    return `<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${escapar(titulo())}</title>
<style>
  body { max-width: 720px; margin: 40px auto; padding: 0 20px; font: 16px/1.7 system-ui, sans-serif; color: #1c1917; }
  pre { background: #f5f5f4; padding: 14px; border-radius: 8px; overflow-x: auto; }
  code { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.9em; }
  :not(pre) > code { background: #f5f5f4; padding: 2px 5px; border-radius: 4px; }
  blockquote { margin: 0; padding: 4px 16px; border-left: 3px solid #4f46e5; color: #57534e; }
  table { border-collapse: collapse; } th, td { border: 1px solid #e7e5e4; padding: 6px 12px; }
  img { max-width: 100%; }
</style>
</head>
<body>
${aHtml(texto.value)}
</body>
</html>`;
  }

  $('md').addEventListener('click', () =>
    descargar(new Blob([texto.value], { type: 'text/markdown;charset=utf-8' }), `${nombreArchivo()}.md`),
  );
  $('html').addEventListener('click', () =>
    descargar(new Blob([documentoHtml()], { type: 'text/html;charset=utf-8' }), `${nombreArchivo()}.html`),
  );
  $('copiar-html').addEventListener('click', () => copiar(aHtml(texto.value), 'HTML copiado al portapapeles.'));
  // El PDF se genera con el diálogo de impresión del navegador ("Guardar como PDF"):
  // así el texto queda seleccionable y con buena calidad.
  $('pdf').addEventListener('click', () => {
    document.title = titulo();
    window.print();
  });
  $('reiniciar').addEventListener('click', () => {
    if (texto.value !== EJEMPLO && !confirm('¿Reemplazar tu texto por el ejemplo?')) return;
    texto.value = EJEMPLO;
    actualizar();
    avisar('');
  });

  let inicial = EJEMPLO;
  try {
    inicial = localStorage.getItem('markdown-borrador') ?? EJEMPLO;
  } catch {}
  texto.value = inicial;
  actualizar();
</script>

<style>
  .editor { padding: 0; overflow: hidden; }
  .barra-herramientas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
  }
  .barra-herramientas [data-accion] {
    min-width: 34px;
    height: 34px;
    border: 1px solid transparent;
    border-radius: 8px;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .barra-herramientas [data-accion]:hover { background: var(--accent-soft); color: var(--accent); }
  .separador { width: 1px; height: 22px; background: var(--border); margin: 0 4px; }
  .espacio { flex: 1; }
  .modos { display: none; gap: 2px; padding: 3px; border: 1px solid var(--border); border-radius: 9px; }
  .modos button { border: 0; background: none; color: var(--muted); font: inherit; font-size: 0.85rem; font-weight: 600; padding: 5px 10px; border-radius: 6px; cursor: pointer; }
  .modos button[aria-selected='true'] { background: var(--accent); color: var(--on-accent); }

  .paneles { display: grid; grid-template-columns: 1fr 1fr; height: 62vh; min-height: 420px; }
  #texto {
    width: 100%;
    height: 100%;
    resize: none;
    border: 0;
    border-right: 1px solid var(--border);
    border-radius: 0;
    padding: 20px;
    font-size: 0.92rem;
    line-height: 1.7;
    background: var(--surface);
  }
  #texto:focus { outline: none; }
  .vista { overflow-y: auto; padding: 8px 28px 28px; }
  @media (max-width: 760px) {
    .modos { display: flex; }
    .paneles { grid-template-columns: 1fr; }
    #texto { border-right: 0; }
    .paneles[data-modo='editar'] .vista,
    .paneles[data-modo='vista'] #texto { display: none; }
  }

  .pie {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 14px;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--muted);
  }
  #guardado { color: var(--ok); }
  .exportar { margin-top: 20px; }

  /* Estilos del documento renderizado */
  .vista :global(h1) { font-size: 1.9rem; margin: 20px 0 12px; }
  .vista :global(h2) { font-size: 1.35rem; margin: 28px 0 10px; }
  .vista :global(pre) { background: var(--bg); border: 1px solid var(--border); padding: 14px; border-radius: 8px; overflow-x: auto; }
  .vista :global(code) { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.88em; }
  .vista :global(:not(pre) > code) { background: var(--accent-soft); padding: 2px 5px; border-radius: 4px; }
  .vista :global(blockquote) { margin: 16px 0; padding: 4px 16px; border-left: 3px solid var(--accent); color: var(--muted); }
  .vista :global(table) { border-collapse: collapse; width: 100%; }
  .vista :global(th), .vista :global(td) { border: 1px solid var(--border); padding: 6px 12px; text-align: left; }
  .vista :global(li:has(> input[type='checkbox'])) { list-style: none; margin-left: -1.3em; }
  .vista :global(input[type='checkbox']) { accent-color: var(--accent); margin-right: 6px; }
  .vista :global(img) { max-width: 100%; }

  /* Al imprimir (Exportar PDF) solo se ve el documento. */
  @media print {
    :global(body) { background: #fff !important; }
    :global(.nav), :global(.footer), :global(.cabecera), :global(.aviso), .barra-herramientas, .pie, .exportar, #texto { display: none !important; }
    .editor { border: 0; }
    .paneles { display: block !important; height: auto; }
    .vista { display: block !important; overflow: visible; padding: 0; color: #000; }
  }
</style>
